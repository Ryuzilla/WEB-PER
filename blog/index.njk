      <a href="#travel">Travel</a>
      <a href="#health">Health</a>
      <a href="#style">Style</a>
      <a href="/" class="active">Studio ↗</a>
    </div>
    <a href="mailto:hello@ryuology.studio" class="nav-cta">Subscribe</a>
    <a href="/blog/search.html" class="nav-search-btn" aria-label="ค้นหา">
