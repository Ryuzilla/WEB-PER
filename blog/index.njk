{% set allPosts = collections.posts | reverse %}
{% set featuredPost = null %}
{% for post in allPosts %}
  {% if post.data.featured and not featuredPost %}
    {% set featuredPost = post %}
  {% endif %}
{% endfor %}
{% if not featuredPost %}
  {% set featuredPost = allPosts[0] %}
{% endif %}

<section class="blog-hero">
  <div class="blog-hero-inner reveal">
    <div class="blog-hero-left">
      <p class="blog-hero-label">THE JOURNAL · LIFESTYLE CONTENT</p>
      <h1>Life,<br><em>Curated</em>.</h1>
      <p class="blog-hero-sub">บทความคัดสรรเรื่องชีวิตที่ดี อาหาร การเดินทาง สุขภาพ และสไตล์ที่คุณเป็น</p>
    </div>
    <div class="blog-hero-stats">
      <div class="blog-hero-stat">
        <div class="blog-hero-stat-val">{{ collections.posts | length }}</div>
        <div class="blog-hero-stat-label">POSTS</div>
      </div>
      <div class="blog-hero-stat">
        <div class="blog-hero-stat-val">{{ collections.posts | uniqueCategories }}</div>
        <div class="blog-hero-stat-label">TOPICS</div>
      </div>
      <div class="blog-hero-stat">
        <div class="blog-hero-stat-val">2026</div>
        <div class="blog-hero-stat-label">SINCE</div>
      </div>
    </div>
  </div>
</section>

<div class="journal-bar">
  <div class="journal-bar-inner">
    <button class="filter-pill active" data-filter="all" id="filter-bar">All</button>
    <button class="filter-pill" data-filter="food">Food</button>
    <button class="filter-pill" data-filter="travel">Travel</button>
    <button class="filter-pill" data-filter="health">Health</button>
    <button class="filter-pill" data-filter="style">Style</button>
    <span class="bar-divider"></span>
    <div class="bar-search-wrap">
      <span class="bar-search-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="search" id="search-input" class="bar-search-input" placeholder="ค้นหา..." autocomplete="off" aria-label="ค้นหาบทความ">
      <button class="bar-search-clear" id="search-clear" aria-label="ล้าง">✕</button>
    </div>
  </div>
</div>

<p class="search-empty" id="search-empty" hidden>ไม่พบบทความที่ตรงกับ "<span id="search-query"></span>"</p>

{% if featuredPost %}
<section class="featured-section reveal">
  <p class="featured-label">FEATURED</p>
  <a href="{{ featuredPost.url }}" class="featured-card" data-category="{{ featuredPost.data.category | lower }}">
    <div class="featured-img">
      <div class="img-placeholder">FEATURED · {{ featuredPost.data.category | upper }}</div>
    </div>
    <div class="featured-content">
      <div class="featured-badge">
        <span class="category-tag">{{ featuredPost.data.category | upper }}</span>
        <span class="read-time">{{ featuredPost.data.readTime }} read</span>
      </div>
      <h2>{{ featuredPost.data.title }}</h2>
      <p>{{ featuredPost.data.excerpt }}</p>
      <div class="featured-meta">
        <span>{{ featuredPost.date | thaiDate }}</span>
        <span>โดย The Journal Team</span>
      </div>
      <span class="read-more">อ่านบทความ →</span>
    </div>
  </a>
</section>
{% endif %}

<section class="posts-section">
  <div class="section-header">
    <span class="section-label">LATEST POSTS</span>
    <span class="section-line"></span>
  </div>
  <div class="posts-grid" id="posts-grid">
    {% for post in allPosts %}
    <a href="{{ post.url }}" class="post-card reveal" data-category="{{ post.data.category | lower }}">
      <div class="card-img">{{ post.data.category | upper }} · IMAGE</div>
      <div class="card-body">
        <div class="card-meta">
          <span class="category-tag">{{ post.data.category | upper }}</span>
          <span class="read-time">{{ post.data.readTime }}</span>
        </div>
        <h3>{{ post.data.title }}</h3>
        <p class="card-excerpt">{{ post.data.excerpt }}</p>
        <div class="card-footer">
          <span>{{ post.date | thaiDate }}</span>
          <span>{{ post.data.readTime }} read</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<footer class="footer">
  <div class="footer-inner">
    <span class="footer-logo">RYUOLOGY<span>/</span>JOURNAL</span>
    <span class="footer-copy">© 2026 RYUOLOGY STUDIO · BANGKOK</span>
  </div>
</footer>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  const pills = document.querySelectorAll('.journal-bar .filter-pill');
  const cards = document.querySelectorAll('.post-card[data-category]');
  const featured = document.querySelector('.featured-card[data-category]');
  const searchInput = document.getElementById('search-input');
  const searchClear = document.getElementById('search-clear');
  const searchEmpty = document.getElementById('search-empty');
  const searchQuery = document.getElementById('search-query');

  let activeFilter = 'all';
  let activeSearch = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const title = card.querySelector('h3')?.textContent.toLowerCase() || '';
      const excerpt = card.querySelector('.card-excerpt')?.textContent.toLowerCase() || '';
      const cat = card.dataset.category;
      const matchFilter = activeFilter === 'all' || cat === activeFilter;
      const matchSearch = !activeSearch || title.includes(activeSearch) || excerpt.includes(activeSearch);
      const show = matchFilter && matchSearch;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (featured) {
      const featCat = featured.dataset.category;
      const matchFilter = activeFilter === 'all' || featCat === activeFilter;
      featured.closest('.featured-section').style.display = matchFilter ? '' : 'none';
    }
    searchEmpty.hidden = visible > 0;
    if (searchQuery) searchQuery.textContent = activeSearch;
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.dataset.filter;
      applyFilters();
    });
  });

  searchInput.addEventListener('input', () => {
    activeSearch = searchInput.value.trim().toLowerCase();
    searchClear.style.display = activeSearch ? 'block' : 'none';
    applyFilters();
  });

  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    activeSearch = '';
    searchClear.style.display = 'none';
    applyFilters();
  });

  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); observer.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
</body>
</html>
